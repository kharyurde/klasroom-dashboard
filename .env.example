# Klasroom API (Express backend) — required for all auth, payments, and school
# onboarding as of the Express API migration. See klasroom_api_auth_payments.zip.
VITE_API_URL=http://localhost:5000

# TODO(migration): still used directly by pages/hooks not yet ported to the Express
# API (useAdminData, useParentData, usePlatformData, useStudentData, useTeacherData,
# statement.ts, audit.ts, mfa.ts, ApplyToSchoolPage, ApplicationDetailPage). Once
# those are migrated to API calls, these two vars — and src/lib/supabase.ts itself —
# can be removed. Do not add any *new* direct Supabase usage; go through the API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
